# Development database (never ends in _test)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toktickit?schema=public"

# Test database — must end in _test and differ from DATABASE_URL.
# Run once: npm run test:db:setup
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toktickit_test?schema=public"

# Migration test database — must end in _test and differ from DATABASE_URL.
# Run once: tsx scripts/setup-migration-db.ts
MIGRATION_TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toktickit_migration_test?schema=public"

# E2E database — must end in _e2e and differ from DATABASE_URL.
# Reset + seeded by `npm run e2e:setup` (repo root). The Playwright e2e API server
# (port 4100) points here, never at the development database.
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toktickit_e2e?schema=public"

# Initial password for the E2E seed (local dev / CI only — never a real secret).
# The Playwright specs read this same variable; falls back to SEED_INITIAL_PASSWORD.
E2E_SEED_PASSWORD="Welcome#2026"

# Server port
PORT=4000

# Allowed client origin for CORS (credentials: true; no wildcard)
CLIENT_ORIGIN="http://localhost:5173"

# bcrypt cost factor (BR-10: minimum 10)
BCRYPT_COST=10

# Absolute session lifetime in hours (BR-11)
SESSION_TTL_HOURS=8

# Initial password for the seed script (local development only — never commit a real value)
SEED_INITIAL_PASSWORD="Welcome#2026"
