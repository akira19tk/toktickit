// Prisma schema for TokTickIT
// Lab 1: Category model
// Lab 2: DevRequester, RelatedSystem; isActive added to Category

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model DevRequester {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model RelatedSystem {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)
}
